rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper para verificar autenticación y propiedad
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Por defecto, denegar TODO
    match /{document=**} {
      allow read, write: if false;
    }

    // Reglas específicas por colección
    
    match /accounts/{accountId} {
      // Solo lecturas de cuentas propias
      allow read: if isOwner(resource.data.userId);
      // Escrituras PROHIBIDAS (solo backend)
      allow write: if false; 
    }

    match /transactions/{transactionId} {
      // Solo lecturas de transacciones propias
      allow read: if isOwner(resource.data.userId);
      // Escrituras PROHIBIDAS (solo backend)
      allow write: if false;
    }

    match /budgets/{budgetId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

  }
}
