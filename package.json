{
  "name": "financial-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "npx firebase-tools emulators:start --project beta --only auth,firestore,functions",
    "test": "npm run test:unit",
    "test:unit": "vitest run --exclude test/firestore.rules.test.js --exclude test/functions/activateBetaUser.test.js",
    "test:rules": "npx firebase-tools emulators:exec --project beta --only firestore \"vitest run test/firestore.rules.test.js\"",
    "test:functions": "npx firebase-tools emulators:exec --project beta --only firestore,functions \"vitest run test/functions/activateBetaUser.test.js\"",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:functions",
    "test:watch": "vitest"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase": "^12.18.0",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
