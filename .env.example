VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Emulators Configuration
# Habilitar para apuntar el frontend a los emuladores locales en lugar de a la nube
VITE_USE_FIREBASE_EMULATORS="true"

# Region de Cloud Functions
VITE_FIREBASE_FUNCTIONS_REGION="southamerica-east1"

# Transporte del backend: "http" = endpoints /api (Vercel o `npm run dev:api` en local);
# vacío = Callables de Firebase (requiere plan Blaze en la nube)
VITE_API_TRANSPORT="http"
